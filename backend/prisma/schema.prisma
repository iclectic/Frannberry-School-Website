generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
  HEAD
}

enum SchoolPhase {
  NURSERY
  PRIMARY
  SECONDARY
}

enum KeyStage {
  EYFS
  KS1
  KS2
  KS3
  KS4
  KS5
}

enum ConversationPurpose {
  PARENT_TEACHER
  PARENT_HEAD
  TEACHER_TEACHER
  TEACHER_HEAD
  PUPIL_TEACHER
}

enum AssessmentType {
  EXAM
  TEST
  QUIZ
  COURSEWORK
  PROJECT
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum AnnouncementScope {
  SCHOOL
  CLASS
}

enum MessageType {
  TEXT
  FILE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  ANNOUNCEMENT
  MESSAGE
  ASSIGNMENT
  RESULT
  ATTENDANCE
  FEE
  EVENT
  GENERAL
}

enum EventType {
  ACADEMIC
  EXAM
  HOLIDAY
  SPORTS
  CULTURAL
  MEETING
  OTHER
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  MFA_ENABLE
  MFA_DISABLE
  PASSWORD_CHANGE
  INVITE_SENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  role          Role
  isActive      Boolean  @default(true) @map("is_active")
  avatarUrl     String?  @map("avatar_url")
  phone         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // MFA. mfaSecret is an encrypted authenticator secret, never a password-reset token.
  mfaEnabled    Boolean  @default(false) @map("mfa_enabled")
  mfaSecret     String?  @map("mfa_secret")

  // Sign-in lockout. Five failures lock the account for 15 minutes.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // Refresh tokens (the token column stores a hash)
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  backupCodes    BackupCode[]

  // Role-specific profiles
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  staffProfile   StaffProfile?
  headProfile    HeadProfile?

  // Messaging
  sentMessages     Message[]       @relation("SentMessages")
  conversations    ConversationParticipant[]

  // Announcements
  announcements    Announcement[]

  // Audit
  auditLogs        AuditLog[]

  // Invites sent
  invitesSent      Invite[]

  // Blog posts
  blogPosts        BlogPost[]

  // Attendance marked
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarkedBy")

  // Notifications
  notifications    Notification[]

  // Events created
  eventsCreated    SchoolEvent[] @relation("EventCreator")

  // Payments recorded
  paymentsRecorded Payment[] @relation("PaymentRecorder")

  // Notification preferences
  notificationPreference NotificationPreference?

  // Custom roles
  userCustomRoles UserCustomRole[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  /// SHA-256 hex of the refresh token. The raw token is returned once and is not stored.
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  @@index([userId])
  @@map("refresh_tokens")
}

model Invite {
  id        String       @id @default(uuid())
  email     String
  role      Role
  code      String       @unique
  status    InviteStatus @default(PENDING)
  invitedBy String       @map("invited_by")
  inviter   User         @relation(fields: [invitedBy], references: [id])
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("invites")
}

// ─── Role Profiles ───────────────────────────────────────────────────────────

model TeacherProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId   String   @unique @map("employee_id")
  department   String?
  qualification String?
  joinDate     DateTime @default(now()) @map("join_date")

  // Classes this teacher is assigned to
  classSubjects ClassSubjectTeacher[]

  // Assignments created
  assignments   Assignment[]

  // Results entered
  results       Result[]

  // Timetable slots
  timetableSlots TimetableSlot[]

  // Conference slots
  conferenceSlots ConferenceSlot[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id             String   @id @default(uuid())
  // Nursery pupils have a record and no login. Primary and secondary pupils can sign in.
  userId         String?  @unique @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  admissionNo    String   @unique @map("admission_no")
  dateOfBirth    DateTime? @map("date_of_birth")
  enrollmentDate DateTime @default(now()) @map("enrollment_date")

  schoolId       String?  @map("school_id")
  school         School?  @relation(fields: [schoolId], references: [id])

  // Current class enrolment
  classId        String?  @map("class_id")
  class          Class?   @relation(fields: [classId], references: [id])

  // Parent links
  parentLinks    ParentStudent[]

  // Submissions
  submissions    Submission[]

  // Results
  results        Result[]

  // Attendance
  attendanceRecords AttendanceRecord[]

  // Report cards
  reportCards     ReportCard[]

  // Invoices
  invoices        Invoice[]

  // Conference slots (as subject student)
  conferenceSlots ConferenceSlot[]

  conversations Conversation[]

  @@map("student_profiles")
}

model ParentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation  String?
  address     String?

  // Children links
  childLinks  ParentStudent[]

  // Conference bookings
  conferenceSlots ConferenceSlot[]

  @@map("parent_profiles")
}

model StaffProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String   @unique @map("employee_id")
  department  String?
  position    String?
  permissions String[] @default([])
  joinDate    DateTime @default(now()) @map("join_date")

  @@map("staff_profiles")
}

model ParentStudent {
  id        String         @id @default(uuid())
  parentId  String         @map("parent_id")
  parent    ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String         @map("student_id")
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation  String         @default("Parent")

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// ─── Trust schools ───────────────────────────────────────────────────────────

model School {
  id        String      @id @default(uuid())
  phase     SchoolPhase @unique
  name      String
  ageMin    Int         @map("age_min")
  ageMax    Int         @map("age_max")
  createdAt DateTime    @default(now()) @map("created_at")

  headProfile   HeadProfile?
  classes       Class[]
  students      StudentProfile[]
  conversations Conversation[]

  @@map("schools")
}

model HeadProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId   String   @unique @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id])
  employeeId String   @unique @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("head_profiles")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

model BackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, codeHash])
  @@map("backup_codes")
}

// ─── Academic Structure ──────────────────────────────────────────────────────

model AcademicSession {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  terms     Term[]

  @@map("academic_sessions")
}

model Term {
  id        String          @id @default(uuid())
  name      String
  sessionId String          @map("session_id")
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startDate DateTime        @map("start_date")
  endDate   DateTime        @map("end_date")
  isCurrent Boolean         @default(false) @map("is_current")
  createdAt DateTime        @default(now()) @map("created_at")

  results      Result[]
  assignments  Assignment[]
  reportCards  ReportCard[]
  feeTemplates FeeTemplate[]

  @@map("terms")
}

model Class {
  id        String   @id @default(uuid())
  name      String
  year      Int
  section   String?
  capacity  Int      @default(30)
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  keyStage  KeyStage @map("key_stage")
  createdAt DateTime @default(now()) @map("created_at")

  students       StudentProfile[]
  classSubjects  ClassSubjectTeacher[]
  announcements  Announcement[]
  assignments    Assignment[]
  timetableSlots TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  reportCards    ReportCard[]
  feeTemplates   FeeTemplate[]

  @@unique([name, year, section])
  @@map("classes")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  classSubjects ClassSubjectTeacher[]
  results       Result[]
  assignments   Assignment[]
  timetableSlots TimetableSlot[]

  @@map("subjects")
}

model ClassSubjectTeacher {
  id        String         @id @default(uuid())
  classId   String         @map("class_id")
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String         @map("subject_id")
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String         @map("teacher_id")
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subject_teachers")
}

model GradingScale {
  id        String   @id @default(uuid())
  name      String
  minScore  Float    @map("min_score")
  maxScore  Float    @map("max_score")
  grade     String
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("grading_scales")
}

// ─── Results ─────────────────────────────────────────────────────────────────

model Result {
  id             String         @id @default(uuid())
  studentId      String         @map("student_id")
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String         @map("subject_id")
  subject        Subject        @relation(fields: [subjectId], references: [id])
  termId         String         @map("term_id")
  term           Term           @relation(fields: [termId], references: [id])
  teacherId      String         @map("teacher_id")
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id])
  assessmentType AssessmentType @map("assessment_type")
  score          Float
  maxScore       Float          @default(100) @map("max_score")
  comment        String?
  attachments    FileAttachment[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([studentId, subjectId, termId, assessmentType])
  @@map("results")
}

// ─── Assignments ─────────────────────────────────────────────────────────────

model Assignment {
  id          String           @id @default(uuid())
  title       String
  description String?
  teacherId   String           @map("teacher_id")
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id])
  classId     String           @map("class_id")
  class       Class            @relation(fields: [classId], references: [id])
  subjectId   String           @map("subject_id")
  subject     Subject          @relation(fields: [subjectId], references: [id])
  termId      String           @map("term_id")
  term        Term             @relation(fields: [termId], references: [id])
  status      AssignmentStatus @default(DRAFT)
  dueDate     DateTime         @map("due_date")
  maxScore    Float            @default(100) @map("max_score")
  attachments FileAttachment[]
  submissions Submission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String           @map("assignment_id")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String           @map("student_id")
  student      StudentProfile   @relation(fields: [studentId], references: [id])
  status       SubmissionStatus @default(PENDING)
  content      String?
  score        Float?
  feedback     String?
  submittedAt  DateTime?        @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  attachments  FileAttachment[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// ─── Messaging ───────────────────────────────────────────────────────────────

model Conversation {
  id           String   @id @default(uuid())
  title        String?
  isModerated  Boolean  @default(false) @map("is_moderated")
  purpose      ConversationPurpose
  schoolId     String   @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    String?  @map("student_id")
  student      StudentProfile? @relation(fields: [studentId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([purpose, studentId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?    @map("last_read_at")
  isMuted        Boolean      @default(false) @map("is_muted")
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  type           MessageType  @default(TEXT)
  content        String
  isDeleted      Boolean      @default(false) @map("is_deleted")
  attachments    FileAttachment[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

// ─── Announcements ───────────────────────────────────────────────────────────

model Announcement {
  id          String            @id @default(uuid())
  title       String
  content     String
  scope       AnnouncementScope @default(SCHOOL)
  classId     String?           @map("class_id")
  class       Class?            @relation(fields: [classId], references: [id])
  authorId    String            @map("author_id")
  author      User              @relation(fields: [authorId], references: [id])
  isPublished Boolean           @default(false) @map("is_published")
  publishAt   DateTime?         @map("publish_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("announcements")
}

// ─── CMS (Blog & Gallery) ───────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?  @map("cover_image")
  authorId    String   @map("author_id")
  author      User     @relation(fields: [authorId], references: [id])
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model GalleryImage {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String   @map("image_url")
  category    String?
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("gallery_images")
}

// ─── File Attachments ────────────────────────────────────────────────────────

model FileAttachment {
  id           String      @id @default(uuid())
  fileName     String      @map("file_name")
  fileUrl      String      @map("file_url")
  fileSize     Int         @map("file_size")
  mimeType     String      @map("mime_type")
  uploadedAt   DateTime    @default(now()) @map("uploaded_at")

  // Polymorphic relations (nullable foreign keys)
  resultId     String?     @map("result_id")
  result       Result?     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  assignmentId String?     @map("assignment_id")
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?     @map("submission_id")
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  messageId    String?     @map("message_id")
  message      Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("file_attachments")
}

// ─── Timetable ──────────────────────────────────────────────────────────────

model TimetableSlot {
  id        String    @id @default(uuid())
  classId   String    @map("class_id")
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String    @map("subject_id")
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String    @map("teacher_id")
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  day       DayOfWeek
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  room      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([classId, day, startTime])
  @@index([teacherId, day])
  @@map("timetable_slots")
}

// ─── Attendance ─────────────────────────────────────────────────────────────

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String           @map("class_id")
  class     Class            @relation(fields: [classId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus
  remark    String?
  markedById String          @map("marked_by_id")
  markedBy  User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([studentId, classId, date])
  @@index([classId, date])
  @@map("attendance_records")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Report Cards ───────────────────────────────────────────────────────────

model ReportCard {
  id              String         @id @default(uuid())
  studentId       String         @map("student_id")
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId          String         @map("term_id")
  term            Term           @relation(fields: [termId], references: [id])
  classId         String         @map("class_id")
  class           Class          @relation(fields: [classId], references: [id])
  totalScore      Float?         @map("total_score")
  averageScore    Float?         @map("average_score")
  subjectCount    Int?           @map("subject_count")
  overallGrade    String?        @map("overall_grade")
  teacherComment  String?        @map("teacher_comment")
  principalComment String?       @map("principal_comment")
  generatedAt     DateTime       @default(now()) @map("generated_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([studentId, termId])
  @@map("report_cards")
}

// ─── Events Calendar ────────────────────────────────────────────────────────

model SchoolEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        EventType @default(OTHER)
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  allDay      Boolean   @default(true) @map("all_day")
  location    String?
  isPublic    Boolean   @default(true) @map("is_public")
  createdById String    @map("created_by_id")
  createdBy   User      @relation("EventCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([startDate, endDate])
  @@map("school_events")
}

// ─── Fee Management ─────────────────────────────────────────────────────────

model FeeTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  amount      Float
  termId      String?  @map("term_id")
  term        Term?    @relation(fields: [termId], references: [id])
  classId     String?  @map("class_id")
  class       Class?   @relation(fields: [classId], references: [id])
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")

  invoices    Invoice[]

  @@map("fee_templates")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNo     String    @unique @map("invoice_no")
  studentId     String    @map("student_id")
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTemplateId String    @map("fee_template_id")
  feeTemplate   FeeTemplate @relation(fields: [feeTemplateId], references: [id])
  amount        Float
  amountPaid    Float     @default(0) @map("amount_paid")
  status        FeeStatus @default(UNPAID)
  dueDate       DateTime  @map("due_date")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  payments      Payment[]

  @@index([studentId, status])
  @@map("invoices")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String        @map("invoice_id")
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  method      PaymentMethod @default(OTHER)
  reference   String?
  note        String?
  recordedById String       @map("recorded_by_id")
  recordedBy  User          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  paidAt      DateTime      @default(now()) @map("paid_at")

  @@map("payments")
}

// ─── Parent-Teacher Conferences ─────────────────────────────────────────────

enum ConferenceStatus {
  AVAILABLE
  BOOKED
  COMPLETED
  CANCELLED
}

model ConferenceSlot {
  id          String           @id @default(uuid())
  teacherId   String           @map("teacher_id")
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  startTime   String           @map("start_time")
  endTime     String           @map("end_time")
  location    String?
  meetingUrl  String?          @map("meeting_url")
  status      ConferenceStatus @default(AVAILABLE)
  parentId    String?          @map("parent_id")
  parent      ParentProfile?   @relation(fields: [parentId], references: [id])
  studentId   String?          @map("student_id")
  student     StudentProfile?  @relation(fields: [studentId], references: [id])
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([teacherId, date])
  @@index([parentId])
  @@map("conference_slots")
}

// ─── Notification Preferences ───────────────────────────────────────────────

model NotificationPreference {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAnnouncements  Boolean @default(true) @map("email_announcements")
  emailMessages       Boolean @default(true) @map("email_messages")
  emailAssignments    Boolean @default(true) @map("email_assignments")
  emailResults        Boolean @default(true) @map("email_results")
  emailEvents         Boolean @default(true) @map("email_events")
  emailFees           Boolean @default(true) @map("email_fees")
  pushEnabled         Boolean @default(true) @map("push_enabled")
  digestEnabled       Boolean @default(false) @map("digest_enabled")
  digestFrequency     String  @default("daily") @map("digest_frequency")

  @@map("notification_preferences")
}

// ─── Permissions / RBAC ─────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  baseRole    Role     @map("base_role")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userCustomRoles UserCustomRole[]

  @@map("custom_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  customRoleId String     @map("custom_role_id")
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, permissionId])
  @@map("role_permissions")
}

model UserCustomRole {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRoleId String     @map("custom_role_id")
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, customRoleId])
  @@map("user_custom_roles")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entity     String
  entityId   String?     @map("entity_id")
  details    String?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
